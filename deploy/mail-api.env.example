# /etc/mail-api/mail-api.env  (root:mailapi 0640)
LISTEN_ADDR=127.0.0.1:5300
SMTP_HOST=127.0.0.1
SMTP_PORT=25
DEFAULT_FROM=noreply@wilhelm.my
ALLOWED_FROM_DOMAINS=wilhelm.my
TEST_RECIPIENT=test@wilhelm.my
SITES_FILE=/etc/mail-api/sites.json
# name:key pairs, comma separated. Generate a key with: openssl rand -hex 32
API_KEYS=helptype:CHANGE_ME
