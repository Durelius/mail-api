[Unit]
Description=mail-api: sends mail for the sites on this VPS via local Postfix
After=network.target postfix.service

[Service]
ExecStart=/usr/local/bin/mail-api
EnvironmentFile=/etc/mail-api/mail-api.env
User=mailapi
Group=mailapi
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Scheduled mail lives in /var/lib/mail-api/mail-api.db.
StateDirectory=mail-api
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
